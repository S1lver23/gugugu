# 本機 XAMPP 開發設定。請複製為 .env；真正的 .env 不得提交 Git。
NODE_ENV=development
SESSION_SECRET=change-this-local-development-secret

# MySQL 連線設定。XAMPP 本機開發通常可使用 root 空密碼；若你的 root 有設定密碼，請填入 DB_PASSWORD。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gugugu_db
DB_USER=root
DB_PASSWORD=

# 以逗號分隔可讀取 Node.js API 的網站來源。
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# 選用：Node.js API 監聽的埠號。
PORT=4000

# Gmail 寄信設定：應用程式密碼只填在私有 .env，不得提交 Git。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=yccycc04@gmail.com
SMTP_PASSWORD=
MAIL_FROM_NAME=古估股
MAIL_FROM_ADDRESS=yccycc04@gmail.com
APP_URL=http://localhost/gugugu
# 待寄信功能與驗證完成後才啟用。
EMAIL_ENABLED=false

# 預設只監聽本機；Tunnel 公開前需配置固定允許來源與 HTTPS Cookie。
HOST=127.0.0.1
# 本機預設不信任轉送 IP；已設定本機反向代理時才設 loopback。
TRUST_PROXY=false
